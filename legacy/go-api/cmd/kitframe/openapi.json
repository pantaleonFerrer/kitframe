    "/notifications/{id}/read": { "patch": { "summary": "Mark notification read", "tags": ["notifications"] } },
    "/audit-log": { "get": { "summary": "List audit log", "tags": ["audit"] } },
    "/jobs/{id}": { "get": { "summary": "Get job", "tags": ["jobs"] } },
    "/brands/{id}/collections": { "get": { "summary": "List brand collections", "tags": ["collections"] } },
    "/jobs": { "get": { "summary": "List jobs", "tags": ["jobs"] } },
    "/brands/{id}/users": { "get": { "summary": "List brand users", "tags": ["users"] } },
