FROM python:3.12-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libmagic1 libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/README.md* ./
COPY apps/api/kitframe ./kitframe
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./
RUN pip install --no-cache-dir -e .
RUN useradd -m kitframe && chown -R kitframe:kitframe /app
USER kitframe
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v1/healthz')"
CMD ["kitframe", "api", "--host", "0.0.0.0", "--port", "8080"]
