# APP_ENV=local|test|staging|production
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql+asyncpg://kitframe:kitframe@localhost:5433/kitframe

# Storage — MinIO local OR leave S3_ENDPOINT empty for AWS
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=kitframe-assets
S3_ACCESS_KEY_ID=kitframe
S3_SECRET_ACCESS_KEY=kitframekitframe
S3_USE_PATH_STYLE=true
# All keys are namespaced under this prefix (e.g. kitframe/brands/…, kitframe/seed/…)
S3_KEY_PREFIX=kitframe
# AWS aliases (optional): AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_PRIVATE_BUCKET_NAME / AWS_PUBLIC_BUCKET_NAME → map to S3_*

JWT_SECRET=local-dev-jwt-secret-change-me-now!!
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Providers — fake only in local/test. Staging/production must use bfl + mistral.
IMAGE_PROVIDER=fake
LLM_PROVIDER=fake
# BFL FLUX.2 (EU only)
BFL_API_KEY=
BFL_API_BASE_URL=https://api.eu.bfl.ai/v1
# Mistral
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Email — Mailpit local OR AWS SES SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Kitframe <noreply@kitframe.local>
# SES aliases (optional): EMAIL_SERVER_HOST, EMAIL_SERVER_PORT,
# EMAIL_SERVER_USER, EMAIL_SERVER_PASS

SHOPIFY_API_VERSION=2025-01
METRICS_TOKEN=local-metrics-token
WORKER_CONCURRENCY=4
CORS_ORIGINS=http://localhost:3000
SEED_PASSWORDS=true
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
API_URL=http://localhost:8080/api/v1
